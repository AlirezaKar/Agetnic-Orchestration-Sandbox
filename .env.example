# =============================================================================
#  Agetnic Orchestration Sandbox — copy to .env and fill in ONE provider.
#      cp .env.example .env
#  Never commit .env (it is git-ignored).
#
#  Every provider below is FREE (free permanent tier, free monthly credits, or
#  a local runtime with no account). Two links are given for each:
#     KEY    -> where to create the API key
#     MODELS -> where to see the *live* model IDs you can put in *_MODEL
#  Model IDs change constantly: always copy the exact id from MODELS (or call
#  GET /providers/<name>/models once your key is set).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. WHICH MODEL RUNS THE BACKEND  (the "core")
#    groq | gemini | openrouter | mistral | cloudflare | nvidia | cerebras
#    huggingface | ollama | lmstudio | custom
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Optional: try these if the primary errors out (429 / quota / outage).
# Each one uses its own <PROVIDER>_API_KEY / <PROVIDER>_MODEL below.
LLM_FALLBACKS=gemini,openrouter
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# Optional overrides that apply to the PRIMARY provider only.
# Handy for pointing a preset at a proxy, or using a model not preset for you.
# LLM_BASE_URL=
# LLM_API_KEY=

# -----------------------------------------------------------------------------
# 2. PROVIDER KEYS — fill the one you picked (fallbacks optional)
# -----------------------------------------------------------------------------

# Groq — free, no card: ~30 req/min + daily token caps (14.4k req/day on 8B).
#   KEY    https://console.groq.com/keys
#   MODELS https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini) — free tier, no card, best quality here.
#   KEY    https://aistudio.google.com/apikey
#   MODELS https://ai.google.dev/gemini-api/docs/models
# Free-tier prompts may be used for training.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — ~20 models with a ":free" suffix, 20 req/min, 50 req/day.
#   KEY    https://openrouter.ai/keys
#   MODELS https://openrouter.ai/models?max_price=0     (only :free ids work)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral La Plateforme — free "Experiment" plan, ~2 req/min, monthly token cap.
#   KEY    https://console.mistral.ai/api-keys
#   MODELS https://docs.mistral.ai/getting-started/models/models_overview/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI — 10,000 neurons/day free on every plan.
#   KEY    https://dash.cloudflare.com/profile/api-tokens
#   MODELS https://developers.cloudflare.com/workers-ai/models/
# Also needs your ACCOUNT ID (dashboard → Workers & Pages → Account details).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# NVIDIA NIM (build.nvidia.com) — free developer credits, no card.
#   KEY    https://build.nvidia.com/            (open a model → "Get API Key")
#   MODELS https://build.nvidia.com/models
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Cerebras — fastest option; free trial credits, card required after the trial.
#   KEY    https://cloud.cerebras.ai/
#   MODELS https://inference-docs.cerebras.ai/models/overview
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Hugging Face Inference Providers — small free monthly credits.
#   KEY    https://huggingface.co/settings/tokens
#   MODELS https://huggingface.co/models?inference=warm
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama (local, 100% free, no account, no background server needed beyond
# `ollama serve` which you start yourself when you use it).
#   DOWNLOAD https://ollama.com/download
#   MODELS   https://ollama.com/library        (`ollama pull llama3.2`)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# LM Studio (local GUI, free).
#   DOWNLOAD https://lmstudio.ai/
#   MODELS   https://lmstudio.ai/models        (start the local server, port 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# -----------------------------------------------------------------------------
# 3. CUSTOM PROVIDER — any OpenAI-compatible endpoint
#    (vLLM, LiteLLM, llama.cpp server, a company gateway, a provider that is
#    not preset here, or a preset you want to override).
#    Then set:  LLM_PROVIDER=custom
# -----------------------------------------------------------------------------
CUSTOM_LABEL=custom
CUSTOM_BASE_URL=https://your-provider.example.com/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=
# bearer (default) | raw | none
CUSTOM_AUTH_SCHEME=bearer
CUSTOM_AUTH_HEADER=Authorization
# JSON objects merged into the request (extra headers / body fields)
CUSTOM_EXTRA_HEADERS={}
CUSTOM_EXTRA_BODY={}

# -----------------------------------------------------------------------------
# 4. WEB SEARCH
#    Defaults are keyless and need NO server:  SEARCH_PROVIDERS=ddg,wikipedia
#
#    no key, no server : ddg, wikipedia
#    free key, no server: tavily (1k/mo), serper (2.5k one-off), exa (1k/mo),
#                         google_cse (100/day)
#    needs a server    : searxng  (only kept as an option)
#
#    Failover: put several in SEARCH_PROVIDERS, comma separated, in priority
#    order. The first backend that returns results wins; a failing one (bot
#    challenge, quota, bad key) is reported and skipped.
# -----------------------------------------------------------------------------
SEARCH_PROVIDER=ddg
SEARCH_PROVIDERS=ddg,wikipedia
# Appended after SEARCH_PROVIDER when SEARCH_PROVIDERS is left empty.
SEARCH_FALLBACKS=wikipedia
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20
SEARCH_DEDUPE=true

# DuckDuckGo (keyless). Region e.g. wt-wt (global), us-en, de-de; safe search
# off|moderate|strict.
DUCKDUCKGO_REGION=wt-wt
DUCKDUCKGO_SAFE_SEARCH=moderate

# Wikipedia (keyless) — encyclopedia only, but very reliable.
WIKIPEDIA_LANG=en

# Tavily — 1,000 searches/month free, built for agents.
#   KEY  https://app.tavily.com/home
#   DOCS https://docs.tavily.com/documentation/api-reference/endpoint/search
TAVILY_API_KEY=

# Serper — 2,500 free credits on signup, real Google results.
#   KEY  https://serper.dev/api-key
#   DOCS https://serper.dev/playground
SERPER_API_KEY=

# Exa — 1,000 searches/month free, semantic search.
#   KEY  https://dashboard.exa.ai/api-keys
#   DOCS https://docs.exa.ai/reference/search
EXA_API_KEY=

# Google Programmable Search (CSE) — 100 queries/day free. Needs both values.
#   KEY  https://developers.google.com/custom-search/v1/introduction
#   CX   https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# SearXNG — self-hosted only (docker run -d -p 8080:8080 searxng/searxng).
# Public instances usually disable the JSON API, so this is opt-in.
#   DOCS https://docs.searxng.org/dev/search_api.html
SEARXNG_BASE_URLS=
SEARXNG_API_KEY=

# Jina Reader — used by the fetch_url tool to turn pages into clean text.
# Keyless with low limits; a free key raises them.
#   KEY  https://jina.ai/reader/
JINA_API_KEY=

# -----------------------------------------------------------------------------
# 5. AGENT
# -----------------------------------------------------------------------------
AGENT_MAX_STEPS=4
AGENT_MAX_SEARCH_RESULTS=5
FETCH_MAX_CHARS=4000

# -----------------------------------------------------------------------------
# 6. SERVER
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
