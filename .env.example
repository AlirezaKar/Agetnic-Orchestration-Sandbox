# Agetnic Orchestration Sandbox — cp .env.example .env, then fill the ARAS block.
# The app runs on the ARAS microservices only: no other model, no other search.
# Check it:  python scripts/aras_smoke.py   ·   GET /diagnose   ·   README §2

# ── ARAS: where the services are ─────────────────────────────────────────────
# one host root, the service ports are appended (router 8101 … web 8108);
# through the SSH tunnel this is http://127.0.0.1
ARAS_BASE_URL=
ARAS_TIMEOUT=60

# ── ARAS: tokens (each one falls back to the shared ARAS_TOKEN) ──────────────
ARAS_TOKEN=
ARAS_ROUTER_TOKEN=
ARAS_WEB_TOKEN=
ARAS_OCR_TOKEN=
ARAS_RETRIEVAL_TOKEN=
ARAS_INGESTION_TOKEN=
ARAS_DATA_TOKEN=
ARAS_VECTOR_TOKEN=

# ── router :8101 — the model (required: it is the only model) ────────────────
# an id the router lists (GET /aras/models), e.g. sharif-rayen-gemma4-31b
ARAS_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── web :8108 — the search agent's web_search tool ───────────────────────────
AGENT_MAX_STEPS=4
AGENT_MAX_SEARCH_RESULTS=5

# ── retrieval :8105 + ingestion :8104 — the document agent's knowledge store ─
# the collection to retrieve from, e.g. alireza_notes (empty = no retrieval)
ARAS_COLLECTION=
ARAS_RETRIEVAL_MODE=hybrid
# also index every accepted upload into ARAS_COLLECTION
ARAS_AUTO_INGEST=false

# ── data :8107 — the data agent's analytics backend ──────────────────────────
# identity headers (X-Tenant / X-Owner-External-Id) and the source to query
ARAS_TENANT=
ARAS_OWNER=
ARAS_DATA_SOURCE_ID=

# ── orchestrator (Auto mode) ─────────────────────────────────────────────────
ORCHESTRATOR_ENABLED=true
# auto = rules pick the agents, the model writes each brief (+1 call)
# heuristic = no planner call · llm = the model picks and writes everything
ORCHESTRATOR_PLANNER=auto
# the gate between the agents and the manager: one small call scores every
# report, lists what is missing and rewrites the weak ones before the manager
# reads anything (rules-only when no model is configured)
ORCHESTRATOR_EVALUATE=true
# accept those rewrites; false = score and flag only, the agents' own words go on
ORCHESTRATOR_OPTIMIZE=true
# one small call after the evaluated reports arrive so the manager can ask for
# more work; every follow-up wave goes back through the evaluator
ORCHESTRATOR_REVIEW=true
# how many times the manager may ask for another wave in one run
ORCHESTRATOR_REVIEW_ROUNDS=1
ORCHESTRATOR_SYNTHESIZE=true
# long strings in the browser trace are clipped here; logs/orchestrator/ keeps all
ORCHESTRATOR_TRACE_CHARS=4000
ORCHESTRATOR_LOG_RUNS=true
ORCHESTRATOR_AGENTS=document,search,data,general
ORCHESTRATOR_MAX_PARALLEL=4
ORCHESTRATOR_TIMEOUT=120
ORCHESTRATOR_CONTEXT_CHARS=6000

# ── harness memory (the conversations themselves, not logs) ──────────────────
HARNESS_MEMORY=true
MEMORY_DIR=memory
MEMORY_HISTORY_TURNS=6

# ── attachments (document agent) ─────────────────────────────────────────────
FILES_DIR=.data/files
FILES_MAX_MB=10
FILES_MAX_CHARS=200000
FILES_CONTEXT_CHARS=12000
# show an allow / don't-allow prompt before an agent reads a file (off = allow)
FILES_PERMISSION_PROMPT=false
# .pdf: read by the OCR service :8102 when ARAS_OCR_TOKEN is set (else pip install pypdf)

# ── server / logs ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
# LOG_*: read from the process environment only, not from this file — export them (or run.py --log-level/--log-dir)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATE_MB=5
LOG_BACKUPS=5
