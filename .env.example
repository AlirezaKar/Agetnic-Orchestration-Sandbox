# ══════════════════════════════════════════════════════════════════
#  Agetnic Orchestration Sandbox — environment configuration
#  Copy this file to `.env` and fill in the values you need.
#  Every section is optional: without any API key the sandbox
#  automatically falls back to a deterministic offline Mock LLM so
#  the whole orchestration pipeline stays testable.
# ══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# 1. LLM / ORCHESTRATOR
#    Controls the brains of the system (Manager, Planner, Agents).
#    provider: "groq"  → real API calls (requires GROQ_API_KEY)
#              "mock"  → deterministic offline model (no key needed)
#              "auto"  → use Groq when a key exists, otherwise mock
# ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=auto

# Groq API key — create one free at https://console.groq.com/keys
GROQ_API_KEY=

# Groq OpenAI-compatible endpoint (default is fine for Groq cloud)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model used for orchestration reasoning (Manager + Planner)
GROQ_MODEL_ORCHESTRATOR=llama-3.3-70b-versatile

# Model used for worker agents (General / Number / Web / Document)
GROQ_MODEL_AGENT=llama-3.3-70b-versatile

# Sampling defaults for orchestration calls
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ──────────────────────────────────────────────────────────────────
# 2. WEB SEARCH  (open-source stack: SearXNG + Crawl4AI)
#    provider: "simulated" → offline deterministic results (default)
#              "searxng"   → self-hosted SearXNG metasearch engine
#
#    SearXNG instance (docker):
#      docker run -d -p 8888:8080 -v ./searxng-settings.yml:/etc/searxng/settings.yml searxng/searxng
#    …and enable the JSON API in its settings.yml:
#      search:
#        formats: [html, json]
# ──────────────────────────────────────────────────────────────────
WEB_SEARCH_PROVIDER=simulated

# SearXNG instance URL (+ optional API key when the instance is behind auth)
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_API_KEY=

# Optional query shaping: language code (e.g. "en"), time range
# ('' | day | month | year), and safe-search (0 = off, 1 = moderate, 2 = strict)
SEARXNG_LANGUAGE=
SEARXNG_TIME_RANGE=
SEARXNG_SAFESEARCH=0

# ──────────────────────────────────────────────────────────────────
# 2b. CRAWL4AI  (deep-crawls the top search results into markdown
#     the LLM can reason over).  Requires: pip install crawl4ai &&
#     crawl4ai-setup  — otherwise a lightweight HTTP fetcher is used.
# ──────────────────────────────────────────────────────────────────
CRAWL4AI_ENABLED=true

# How many top search results to deep-crawl per query (0 = snippets only)
CRAWL4AI_MAX_PAGES=2

# Per-page content cap (characters) for prompts and trace files
CRAWL4AI_MAX_CONTENT_CHARS=6000

# Seconds to wait for one page to be crawled
PAGE_FETCH_TIMEOUT=20

# ──────────────────────────────────────────────────────────────────
# 3. ORCHESTRATION
#    Tuning knobs for the Manager / Planner / parallel Executor.
# ──────────────────────────────────────────────────────────────────
# Maximum number of agent tasks executed in parallel per wave
MAX_PARALLEL_TASKS=4

# How many times the Manager may re-plan after a failed/insufficient task
MAX_REPLAN_ATTEMPTS=1

# Hard cap on tasks a single plan may contain (safety guard)
MAX_PLAN_TASKS=8

# Seconds before an individual agent task is considered failed
TASK_TIMEOUT_SECONDS=90

# ──────────────────────────────────────────────────────────────────
# 4. STORAGE
#    Where debug traces and uploaded documents live on disk.
# ──────────────────────────────────────────────────────────────────
TRACE_DIR=traces
DOCUMENT_DIR=data/documents

# ──────────────────────────────────────────────────────────────────
# 5. SERVER
#    FastAPI test-harness server binding.
# ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated extra origins allowed by CORS (the UI is served
# from the same origin, so this is only needed when hosting separately).
CORS_EXTRA_ORIGINS=
