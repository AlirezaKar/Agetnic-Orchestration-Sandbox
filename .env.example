# Agetnic Orchestration Sandbox — cp .env.example .env
# LLM_PROVIDER=auto uses the first provider below that has a key and a model.
# Model ids are required and change often: copy one from the "models" link.

# ── model ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=auto
LLM_FALLBACKS=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ── providers: key + model (links: key, models) ───────────────────────────────
# groq        https://console.groq.com/keys           https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=

# gemini      https://aistudio.google.com/apikey      https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=

# openrouter  https://openrouter.ai/keys              https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# mistral     https://console.mistral.ai/api-keys     https://docs.mistral.ai/getting-started/models/models_overview/
MISTRAL_API_KEY=
MISTRAL_MODEL=

# cerebras    https://cloud.cerebras.ai/              https://inference-docs.cerebras.ai/models/overview
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# nvidia      https://build.nvidia.com/               https://build.nvidia.com/models
NVIDIA_API_KEY=
NVIDIA_MODEL=

# cloudflare  https://dash.cloudflare.com/profile/api-tokens   https://developers.cloudflare.com/workers-ai/models/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=

# huggingface https://huggingface.co/settings/tokens  https://huggingface.co/models?inference=warm
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

# ollama (local, no key)  https://ollama.com/library
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# lmstudio (local, no key)  https://lmstudio.ai/models
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# custom (any OpenAI-compatible endpoint; key optional)
CUSTOM_LABEL=custom
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_AUTH_SCHEME=bearer
CUSTOM_AUTH_HEADER=Authorization
CUSTOM_EXTRA_HEADERS={}
CUSTOM_EXTRA_BODY={}

# ── search (defaults need no key and no server) ───────────────────────────────
SEARCH_PROVIDER=ddg
SEARCH_PROVIDERS=ddg,wikipedia
SEARCH_FALLBACKS=wikipedia
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20
SEARCH_DEDUPE=true
DUCKDUCKGO_REGION=wt-wt
DUCKDUCKGO_SAFE_SEARCH=moderate
WIKIPEDIA_LANG=en

# tavily     https://app.tavily.com/home
TAVILY_API_KEY=
# serper     https://serper.dev/api-key
SERPER_API_KEY=
# exa        https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# google cse https://developers.google.com/custom-search/v1/introduction  + https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# searxng (self-hosted)  https://docs.searxng.org/dev/search_api.html
SEARXNG_BASE_URLS=
SEARXNG_API_KEY=
# jina reader (optional, raises fetch limits)  https://jina.ai/reader/
JINA_API_KEY=

# ── agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=4
AGENT_MAX_SEARCH_RESULTS=5
FETCH_MAX_CHARS=4000

# ── server / logs ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATE_MB=5
LOG_BACKUPS=5

# ── orchestrator (Auto mode) ──────────────────────────────────────────────────
ORCHESTRATOR_ENABLED=true
# auto = rules pick the agents, the model writes each brief (+1 call)
# heuristic = no planner call · llm = the model picks and writes everything
ORCHESTRATOR_PLANNER=auto
# one small call after the agents report so the manager can ask for more work
ORCHESTRATOR_REVIEW=true
ORCHESTRATOR_SYNTHESIZE=true
# long strings in the browser trace are clipped here; logs/orchestrator/ keeps all
ORCHESTRATOR_TRACE_CHARS=4000
ORCHESTRATOR_LOG_RUNS=true
ORCHESTRATOR_AGENTS=document,search,data,general
ORCHESTRATOR_MAX_PARALLEL=4
ORCHESTRATOR_TIMEOUT=120
ORCHESTRATOR_CONTEXT_CHARS=6000

# ── attachments (document agent) ──────────────────────────────────────────────
FILES_DIR=.data/files
FILES_MAX_MB=10
FILES_MAX_CHARS=200000
FILES_CONTEXT_CHARS=12000
# .pdf needs: pip install pypdf
